<!DOCTYPE html>
<html lang="es" class="dark" style="scroll-behavior: smooth;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flash TopUp - Tienda de Diamantes Free Fire</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gaming: {
                            dark: '#0f172a',
                            card: '#1e293b',
                            accent: '#f59e0b',
                            accentHover: '#d97706',
                            neon: '#10b981',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .glow-effect { box-shadow: 0 0 25px rgba(245, 158, 11, 0.25); }
        .glow-green { box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
    </style>
</head>
<body class="bg-gaming-dark text-slate-100 min-h-screen flex flex-col selection:bg-amber-500 selection:text-black">

    <!-- TOP HEADER / NAVBAR -->
    <header class="sticky top-0 z-50 bg-gaming-card/90 backdrop-blur-md border-b border-slate-800 shadow-lg">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="bg-amber-500 text-gaming-dark p-2 rounded-xl font-black text-xl flex items-center justify-center w-10 h-10 shadow-md glow-effect">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-lg tracking-wider text-white leading-tight">FLASH <span class="text-amber-500">TOPUP</span></h1>
                    <p class="text-[10px] text-emerald-400 font-semibold tracking-widest uppercase flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Sistema Online 24/7
                    </p>
                </div>
            </div>
            
            <div class="text-right">
                <span class="text-[10px] text-slate-400 block font-semibold uppercase tracking-wider">Tasa del día</span>
                <span id="rateBadge" class="text-xs font-bold text-amber-500 bg-slate-900 border border-slate-700 px-2.5 py-1 rounded-lg">882.00 Bs / $</span>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl mx-auto px-4 py-6 flex-grow w-full space-y-6">

        <!-- HERO BANNER PROMO -->
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-amber-600 via-amber-500 to-yellow-600 p-6 text-black shadow-xl glow-effect">
            <div class="absolute -right-6 -bottom-10 opacity-15 text-9xl font-black select-none pointer-events-none">
                <i class="fa-solid fa-gem"></i>
            </div>
            <div class="relative z-10 max-w-lg">
                <span class="bg-black/20 text-black text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-2 inline-block">Recargas Seguras por ID</span>
                <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight leading-tight">¡Diamantes al Instante para Free Fire!</h2>
                <p class="text-sm font-medium mt-1 opacity-90">Ingresa tu ID, elige tu paquete, realiza tu pago y envía la captura por WhatsApp.</p>
            </div>
        </div>

        <!-- STEP 1: PLAYER ID INPUT & VERIFICATION -->
        <section id="step1" class="bg-gaming-card rounded-2xl p-5 border border-slate-800 shadow-md">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-base flex items-center gap-2 text-white">
                    <span class="w-7 h-7 rounded-full bg-amber-500 text-black text-xs font-extrabold flex items-center justify-center">1</span>
                    Ingresa tu ID de Jugador
                </h3>
                <span class="text-xs text-slate-400"><i class="fa-solid fa-shield-halved text-emerald-400"></i> Seguro</span>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-grow">
                    <input type="number" id="playerId" placeholder="Ejemplo: 123456789" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 text-sm font-medium transition">
                </div>
                <button onclick="verifyId()" class="bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold px-5 py-3 rounded-xl text-sm transition flex items-center justify-center gap-2 shadow">
                    <i class="fa-solid fa-user-check"></i> Verificar ID
                </button>
            </div>
            <p id="idStatus" class="text-xs mt-2 hidden font-medium"></p>
        </section>

        <!-- STEP 2: SELECT DIAMOND PACKAGE -->
        <section id="step2" class="bg-gaming-card rounded-2xl p-5 border border-slate-800 shadow-md">
            <h3 class="font-bold text-base flex items-center gap-2 text-white mb-4">
                <span class="w-7 h-7 rounded-full bg-amber-500 text-black text-xs font-extrabold flex items-center justify-center">2</span>
                Selecciona tu Paquete de Diamantes
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="packagesGrid">
                <!-- 100 Diamonds -->
                <div onclick="selectPackage(this, 100, 1.10, '100 Diamantes + 10 Bónus')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <i class="fa-solid fa-gem text-3xl text-amber-500 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">100 + 10</span>
                    <span class="text-xs text-slate-400 mb-2">Diamantes</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$1.10 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="1.10">-- Bs</span>
                    </div>
                </div>

                <!-- 310 Diamonds -->
                <div onclick="selectPackage(this, 310, 3.20, '310 Diamantes + 31 Bónus')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <i class="fa-solid fa-gem text-3xl text-amber-500 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">310 + 31</span>
                    <span class="text-xs text-slate-400 mb-2">Diamantes</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$3.20 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="3.20">-- Bs</span>
                    </div>
                </div>

                <!-- 520 Diamonds -->
                <div onclick="selectPackage(this, 520, 5.20, '520 Diamantes + 52 Bónus')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <span class="absolute -top-2 bg-amber-500 text-black font-extrabold text-[9px] px-2 py-0.5 rounded-full uppercase">Popular</span>
                    <i class="fa-solid fa-gem text-3xl text-amber-500 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">520 + 52</span>
                    <span class="text-xs text-slate-400 mb-2">Diamantes</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$5.20 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="5.20">-- Bs</span>
                    </div>
                </div>

                <!-- 1060 Diamonds -->
                <div onclick="selectPackage(this, 1060, 10.20, '1060 Diamantes + 106 Bónus')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <i class="fa-solid fa-gem text-3xl text-amber-500 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">1060 + 106</span>
                    <span class="text-xs text-slate-400 mb-2">Diamantes</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$10.20 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="10.20">-- Bs</span>
                    </div>
                </div>

                <!-- Membresía Semanal -->
                <div onclick="selectPackage(this, 'SEMANAL', 2.30, 'Membresía Semanal Free Fire')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <i class="fa-solid fa-crown text-3xl text-yellow-400 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">Pase Semanal</span>
                    <span class="text-xs text-slate-400 mb-2">450 Dms Valor</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$2.30 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="2.30">-- Bs</span>
                    </div>
                </div>

                <!-- Membresía Mensual -->
                <div onclick="selectPackage(this, 'MENSUAL', 10.50, 'Membresía Mensual Free Fire')" class="package-card cursor-pointer bg-slate-900/80 hover:bg-slate-800 border-2 border-slate-700/80 hover:border-amber-500/50 rounded-xl p-4 transition-all duration-200 flex flex-col items-center text-center relative group">
                    <i class="fa-solid fa-shield-cat text-3xl text-amber-400 my-2 group-hover:scale-110 transition-transform"></i>
                    <span class="font-extrabold text-white text-base">Pase Mensual</span>
                    <span class="text-xs text-slate-400 mb-2">2600 Dms Valor</span>
                    <div class="mt-auto pt-2 border-t border-slate-800 w-full flex flex-col items-center">
                        <span class="text-amber-500 font-extrabold text-sm">$10.50 USD</span>
                        <span class="text-[11px] text-slate-400 font-medium price-ves" data-usd="10.50">-- Bs</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- STEP 3: PAYMENT METHOD -->
        <section id="step3" class="bg-gaming-card rounded-2xl p-5 border border-slate-800 shadow-md">
            <h3 class="font-bold text-base flex items-center gap-2 text-white mb-4">
                <span class="w-7 h-7 rounded-full bg-amber-500 text-black text-xs font-extrabold flex items-center justify-center">3</span>
                Método de Pago
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <!-- Pago Móvil -->
                <label onclick="selectPayment(this, 'Pago Móvil')" class="payment-card cursor-pointer bg-slate-900 border-2 border-slate-700 hover:border-amber-500/50 p-4 rounded-xl flex items-center gap-3 transition">
                    <input type="radio" name="payment" class="hidden">
                    <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center text-white text-base font-bold shadow">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-white">Pago Móvil</p>
                        <p class="text-xs text-slate-400">Banco de Venezuela (Bs)</p>
                    </div>
                </label>

                <!-- Binance Pay -->
                <label onclick="selectPayment(this, 'Binance Pay')" class="payment-card cursor-pointer bg-slate-900 border-2 border-slate-700 hover:border-amber-500/50 p-4 rounded-xl flex items-center gap-3 transition">
                    <input type="radio" name="payment" class="hidden">
                    <div class="w-10 h-10 rounded-lg bg-yellow-500 flex items-center justify-center text-black text-base font-bold shadow">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-white">Binance Pay</p>
                        <p class="text-xs text-slate-400">Pay ID / UID (USDT)</p>
                    </div>
                </label>
            </div>

            <!-- PAYMENT DETAILS BOX -->
            <div id="paymentDetails" class="mt-4 p-4 rounded-xl bg-slate-900 border border-amber-500/30 hidden">
                <h4 id="paymentDetailsTitle" class="text-xs font-bold text-amber-500 uppercase tracking-wider mb-2">Datos para transferir:</h4>
                <div id="paymentDetailsContent" class="text-xs text-slate-300 space-y-1 font-mono">
                    <!-- Dynamic details loaded by JS -->
                </div>
            </div>
        </section>

        <!-- STEP 4: ORDER SUMMARY & SUBMIT -->
        <section id="step4" class="bg-slate-900 rounded-2xl p-5 border border-slate-800 shadow-lg">
            <h3 class="font-bold text-base text-white mb-3">Resumen del Pedido</h3>
            
            <div class="space-y-2 text-sm border-b border-slate-800 pb-3 mb-4">
                <div class="flex justify-between text-slate-400">
                    <span>ID Jugador:</span>
                    <span id="summaryId" class="text-white font-mono font-bold">No ingresado</span>
                </div>
                <div class="flex justify-between text-slate-400">
                    <span>Paquete:</span>
                    <span id="summaryPackage" class="text-white font-bold">No seleccionado</span>
                </div>
                <div class="flex justify-between text-slate-400">
                    <span>Método Pago:</span>
                    <span id="summaryPayment" class="text-white font-bold">No seleccionado</span>
                </div>
                <div class="flex justify-between text-slate-400 pt-2 border-t border-slate-800/50 text-base">
                    <span class="font-bold text-white">Total USD:</span>
                    <span id="summaryUsd" class="text-amber-500 font-extrabold">$0.00 USD</span>
                </div>
                <div class="flex justify-between text-slate-400 text-sm">
                    <span class="font-bold text-slate-300">Total en Bs:</span>
                    <span id="summaryVes" class="text-emerald-400 font-extrabold">0,00 Bs</span>
                </div>
            </div>

            <!-- WhatsApp Order Button -->
            <button onclick="sendOrder()" class="w-full bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-black py-4 rounded-xl shadow-lg glow-green transition flex items-center justify-center gap-2 text-base">
                <i class="fa-brands fa-whatsapp text-xl"></i> ENVIAR PEDIDO Y CAPTURA POR WHATSAPP
            </button>
            <p class="text-[11px] text-slate-400 text-center mt-2 flex items-center justify-center gap-1">
                <i class="fa-solid fa-paperclip text-amber-500"></i> Recuerda adjuntar tu comprobante de pago en el chat.
            </p>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="bg-gaming-card border-t border-slate-800 py-6 text-center text-xs text-slate-500 mt-auto">
        <p>© 2026 Flash TopUp - Tienda no oficial de Free Fire. Todos los derechos reservados.</p>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // CONFIGURACIÓN DE TU NÚMERO DE WHATSAPP
        const MY_PHONE_NUMBER = "584246041002"; 

        // Tasa Oficial configurada
        const EXCHANGE_RATE_VES = 882.00; 

        // DATOS DE PAGO REALES
        const PAGO_MOVIL_DATA = `
            <p><span class="text-slate-500">Banco:</span> Banco de Venezuela (0102)</p>
            <p><span class="text-slate-500">Cédula:</span> V-30.878.012</p>
            <p><span class="text-slate-500">Teléfono:</span> 0424-6041002</p>
        `;

        const BINANCE_DATA = `
            <p><span class="text-slate-500">Binance Pay ID / UID:</span> 920153175</p>
        `;

        let currentPackage = null;
        let currentPayment = null;

        // Initialize prices on page load
        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById('rateBadge').innerText = `${EXCHANGE_RATE_VES.toFixed(2)} Bs / $`;
            
            document.querySelectorAll('.price-ves').forEach(el => {
                const usd = parseFloat(el.getAttribute('data-usd'));
                const ves = usd * EXCHANGE_RATE_VES;
                el.innerText = `${ves.toLocaleString('es-VE', {minimumFractionDigits: 2, maximumFractionDigits: 2})} Bs`;
            });
        });

        function verifyId() {
            const idInput = document.getElementById('playerId').value.trim();
            const status = document.getElementById('idStatus');
            const summaryId = document.getElementById('summaryId');

            if (idInput.length < 6) {
                status.className = 'text-xs mt-2 font-medium text-red-400';
                status.innerText = '⚠️ Ingrese un ID válido de Free Fire (mínimo 6 dígitos).';
                status.classList.remove('hidden');
                summaryId.innerText = 'No ingresado';
            } else {
                status.className = 'text-xs mt-2 font-medium text-emerald-400';
                status.innerText = '✓ ID Verificado Exitosamente';
                status.classList.remove('hidden');
                summaryId.innerText = idInput;

                // Auto-scroll to Step 2
                setTimeout(() => {
                    document.getElementById('step2').scrollIntoView({ behavior: 'smooth' });
                }, 300);
            }
        }

        function selectPackage(element, id, priceUsd, title) {
            document.querySelectorAll('.package-card').forEach(card => {
                card.classList.remove('border-amber-500', 'bg-slate-800', 'glow-effect');
                card.classList.add('border-slate-700/80', 'bg-slate-900/80');
            });

            element.classList.remove('border-slate-700/80', 'bg-slate-900/80');
            element.classList.add('border-amber-500', 'bg-slate-800', 'glow-effect');

            currentPackage = { id, priceUsd, title };
            updateSummary();

            // Auto-scroll to Step 3
            setTimeout(() => {
                document.getElementById('step3').scrollIntoView({ behavior: 'smooth' });
            }, 300);
        }

        function selectPayment(element, method) {
            document.querySelectorAll('.payment-card').forEach(card => {
                card.classList.remove('border-amber-500', 'bg-slate-800');
                card.classList.add('border-slate-700', 'bg-slate-900');
            });

            element.classList.remove('border-slate-700', 'bg-slate-900');
            element.classList.add('border-amber-500', 'bg-slate-800');

            currentPayment = method;
            document.getElementById('summaryPayment').innerText = method;

            // Show Payment Details Box
            const detailsBox = document.getElementById('paymentDetails');
            const detailsContent = document.getElementById('paymentDetailsContent');
            detailsBox.classList.remove('hidden');

            if (method === 'Pago Móvil') {
                detailsContent.innerHTML = PAGO_MOVIL_DATA;
            } else if (method === 'Binance Pay') {
                detailsContent.innerHTML = BINANCE_DATA;
            }

            // Auto-scroll to Step 4
            setTimeout(() => {
                document.getElementById('step4').scrollIntoView({ behavior: 'smooth' });
            }, 300);
        }

        function updateSummary() {
            const summaryPackage = document.getElementById('summaryPackage');
            const summaryUsd = document.getElementById('summaryUsd');
            const summaryVes = document.getElementById('summaryVes');

            if (!currentPackage) {
                summaryPackage.innerText = 'No seleccionado';
                summaryUsd.innerText = '$0.00 USD';
                summaryVes.innerText = '0,00 Bs';
                return;
            }

            summaryPackage.innerText = currentPackage.title;
            summaryUsd.innerText = `$${currentPackage.priceUsd.toFixed(2)} USD`;
            const ves = currentPackage.priceUsd * EXCHANGE_RATE_VES;
            summaryVes.innerText = `${ves.toLocaleString('es-VE', {minimumFractionDigits: 2, maximumFractionDigits: 2})} Bs`;
        }

        function sendOrder() {
            const playerId = document.getElementById('playerId').value.trim();

            if (!playerId || playerId.length < 6) {
                alert('Por favor, ingresa y verifica tu ID de Jugador primero.');
                document.getElementById('step1').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            if (!currentPackage) {
                alert('Por favor, selecciona un paquete de diamantes.');
                document.getElementById('step2').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            if (!currentPayment) {
                alert('Por favor, selecciona un método de pago.');
                document.getElementById('step3').scrollIntoView({ behavior: 'smooth' });
                return;
            }

            const totalUsd = `$${currentPackage.priceUsd.toFixed(2)} USD`;
            const totalVes = `${(currentPackage.priceUsd * EXCHANGE_RATE_VES).toLocaleString('es-VE', {minimumFractionDigits: 2, maximumFractionDigits: 2})} Bs`;

            const message = `👋 *NUEVO PEDIDO - FLASH TOPUP*\n\n` +
                `🎮 *ID Jugador:* ${playerId}\n` +
                `💎 *Paquete:* ${currentPackage.title}\n` +
                `💳 *Método de Pago:* ${currentPayment}\n` +
                `💰 *Total a Pagar:* ${totalUsd} (${totalVes})\n\n` +
                `_Hola, ya realicé el pago. Te adjunto la captura del comprobante para recibir mi recarga._`;

            const encodedMessage = encodeURIComponent(message);
            window.open(`https://wa.me/${MY_PHONE_NUMBER}?text=${encodedMessage}`, '_blank');
        }
    </script>
</body>
</html>
